# PREVI-LACERDA - Variáveis de Ambiente do Backend em Nuvem
PORT=3001
NODE_ENV=production

# Chave secreta JWT (Gere uma chave longa e segura)
JWT_SECRET=previlacerda_rpps_jwt_secret_key_2026_super_secure

# Banco de Dados PostgreSQL em Nuvem Gratuito (Supabase ou Neon)
# Exemplo Supabase: postgresql://postgres:[SUA_SENHA]@db.[REF_PROJETO].supabase.co:5432/postgres
# Exemplo Neon: postgresql://[USER]:[SENHA]@[HOST].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[REF_PROJETO].supabase.co:5432/postgres

# Origens Autorizadas (Domínio da Vercel ou Domínio Oficial da Prefeitura)
ALLOWED_ORIGINS=https://previlacerda-invest.vercel.app,https://previlacerda.mt.gov.br
